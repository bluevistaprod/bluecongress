# ── Formulaire de contact — SMTP Infomaniak ─────────────────────────────
# Serveur sortant Infomaniak (voir Manager > Mail > Paramètres)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587                       # 587 (STARTTLS) ou 465 (SSL/TLS)
SMTP_USER=contact@bluevistaprod.com # adresse complète = identifiant
SMTP_PASS=                          # mot de passe de la boîte (ou mot de passe d'application)

# Destinataire et expéditeur des messages du formulaire
CONTACT_TO=contact@bluevistaprod.com
CONTACT_FROM=contact@bluevistaprod.com   # doit être une adresse du domaine (anti-spoofing)

# ── Autres (déjà utilisées par l'app) ──────────────────────────────────
# DATABASE_URL=
# JWT_SECRET=
